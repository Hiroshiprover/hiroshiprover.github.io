{
  "name": "my-site",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "build": "docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "typecheck": "tsc",
    "postinstall": "node scripts/patch-docusaurus.cjs",
    "prebuild": "node scripts/patch-docusaurus.cjs",
    "prestart": "node scripts/patch-docusaurus.cjs",
    "test:dependency-patch": "node --test tests/search/dependency-patch.cjs",
    "science:check": "node scripts/check-science.cjs",
    "science:sync": "node scripts/sync-science.mjs",
    "science:python": "tools/science/python/.venv/bin/python tools/science/python/scripts/generate.py",
    "science:tex": "python3 tools/science/tex/scripts/diagrams.py generate",
    "science:tex:setup": "python3 tools/science/tex/scripts/setup-mutool.py"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.1",
    "@docusaurus/faster": "3.10.1",
    "@docusaurus/preset-classic": "3.10.1",
    "@docusaurus/theme-mermaid": "^3.10.1",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.0.0",
    "katex": "0.16.47",
    "prism-react-renderer": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "remark-math-extended": "^6.1.1"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.1",
    "@docusaurus/tsconfig": "3.10.1",
    "@docusaurus/types": "3.10.1",
    "@types/react": "^19.0.0",
    "cheerio": "1.1.2",
    "pagefind": "1.6.0",
    "typescript": "~6.0.2"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=20.18.1"
  }
}
